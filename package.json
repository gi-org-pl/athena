{
  "name": "@gi-org-pl/athena",
  "version": "0.0.0",
  "description": "React component library used by Generacja Innowacja's front-end projects.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/athena.js",
  "module": "./dist/athena.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "author": "generacja-innowacja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gi-org-pl/athena.git"
  },
  "homepage": "https://github.com/gi-org-pl/athena#readme",
  "bugs": {
    "url": "https://github.com/gi-org-pl/athena/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci",
    "format": "biome format --write",
    "format:check": "biome format",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "release": "semantic-release"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@chromatic-com/storybook": "5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-onboarding": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "semantic-release": "25.0.9",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=1.22"
